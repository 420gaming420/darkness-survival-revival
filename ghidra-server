#!/usr/bin/env python3
"""Ghidra server CLI wrapper.

Manages the background HTTP server lifecycle: start, stop, status, restart.
Auto-starts the server on first tool invocation if not already running.

Usage:
    ghidra-server start      # Start server in background
    ghidra-server stop       # Stop server
    ghidra-server status     # Check if server is running
    ghidra-server restart    # Restart server
"""

import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path


_SERVER_SCRIPT = Path(__file__).resolve().parent / "src" / "ui" / "server" / "core.py"
_PID_FILE = Path(__file__).resolve().parent / "ghidra_server.pid"
_PORT = int(os.environ.get("GHIDRA_SERVER_PORT", "18960"))


def is_running():
    import urllib.request

    if not _PID_FILE.exists():
        return False
    try:
        pid = int(_PID_FILE.read_text().strip())
        os.kill(pid, 0)
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{_PORT}/health", timeout=1)
            return True
        except Exception:
            return False
    except (ValueError, FileNotFoundError, ProcessLookupError):
        return False


def start_server():
    if is_running():
        print("[*] Server is already running.")
        return

    print("[*] Starting Ghidra server...")
    env = os.environ.copy()
    env["GHIDRA_SERVER_PORT"] = str(_PORT)

    proc = subprocess.Popen(
        [sys.executable, str(_SERVER_SCRIPT)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=env,
        start_new_session=True,
    )
    _PID_FILE.write_text(str(proc.pid))

    import urllib.request
    for i in range(30):
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{_PORT}/health", timeout=1)
            print(f"[*] Server started (PID {proc.pid}).")
            return
        except Exception:
            time.sleep(1)

    print("[!] Server process started but not yet responsive.")
    print(f"    PID: {proc.pid}")


def stop_server():
    if not is_running():
        print("[*] Server is not running.")
        return

    pid = None
    if _PID_FILE.exists():
        try:
            pid = int(_PID_FILE.read_text().strip())
        except ValueError:
            pass

    import urllib.request
    try:
        data = json.dumps({"jsonrpc": "2.0", "method": "shutdown", "id": 0}).encode()
        req = urllib.request.Request(
            f"http://127.0.0.1:{_PORT}/rpc",
            data=data,
            headers={"Content-Type": "application/json"},
        )
        resp = urllib.request.urlopen(req, timeout=5)
        result = json.loads(resp.read().decode())
        if result.get("result"):
            print("[*] Server stopped gracefully.")
            if _PID_FILE.exists():
                _PID_FILE.unlink()
            return
    except Exception:
        pass

    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            time.sleep(2)
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, FileNotFoundError):
            pass

    print("[*] Server stopped.")
    if _PID_FILE.exists():
        _PID_FILE.unlink()


def status():
    if is_running():
        pid_text = ""
        if _PID_FILE.exists():
            try:
                pid = int(_PID_FILE.read_text().strip())
                pid_text = f" (PID {pid})"
            except ValueError:
                pass
        print(f"[+] Server is running{pid_text}.")

        import urllib.request
        try:
            data = json.dumps({"jsonrpc": "2.0", "method": "status", "id": 0}).encode()
            req = urllib.request.Request(
                f"http://127.0.0.1:{_PORT}/rpc",
                data=data,
                headers={"Content-Type": "application/json"},
            )
            resp = urllib.request.urlopen(req, timeout=5)
            result = json.loads(resp.read().decode())
            info = result.get("result", {})
            if info:
                print(f"    Initialized: {'yes' if info.get('initialized') else 'no'}")
        except Exception:
            pass
    else:
        print("[-] Server is not running.")
        print("    Start with: ghidra-server start")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    cmd = sys.argv[1].lower()
    if cmd == "start":
        start_server()
    elif cmd == "stop":
        stop_server()
    elif cmd == "status":
        status()
    elif cmd == "restart":
        stop_server()
        time.sleep(1)
        start_server()
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)


if __name__ == "__main__":
    main()
