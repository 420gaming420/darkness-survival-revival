# ── Game APK ──────────────────────────────────────────────────────────────────
# Path to the game APK (relative to this directory).
GAME_APK=Darkness_Survival.apk

# ── Ghidra Installation ────────────────────────────────────────────────────────
# Path to your Ghidra installation directory (where support/analyzeHeadless lives).
# Can also be set via environment variable GHIDRA_INSTALL_DIR.
GHIDRA_INSTALL_DIR=/path/to/ghidra

# ── Binary ─────────────────────────────────────────────────────────────────────
# Path to the main binary file to analyze.
# Defaults to: project/lib/armeabi/libcocos2dcpp.so
# BINARY_PATH=/absolute/path/to/binary.so
# NOTE: The binary MUST exist before starting any tool (server.py, decompile.py,
#       export.py, jvm.py, patcher.py). Run ./1-import.sh first to extract it.

# ── Text Data (game-specific) ─────────────────────────────────────────────────
# Path to textdata_en.dat for i18n string resolution.
# Defaults to: project/assets/textdata_en.dat
# TEXTDATA_EN_PATH=/absolute/path/to/textdata_en.dat

# ── Ghidra Project ─────────────────────────────────────────────────────────────
# Parent directory where Ghidra projects are stored.
# Defaults to: tools/ghidra/project
# GHIDRA_PROJECT_DIR=/path/to/ghidra/projects

# Name of the Ghidra project (creates project/<GHIDRA_PROJECT_NAME>/).
# Defaults to: ds_offline
# GHIDRA_PROJECT_NAME=my_project

# ── Processor & Compiler ──────────────────────────────────────────────────────
# Ghidra processor language ID (from *.ldefs files).
# Common values:
#   ARM 32-bit LE:    ARM:LE:32:v5t
#   ARM 32-bit BE:    ARM:BE:32:v7
#   x86 32-bit:       x86:LE:32:default
#   x86 64-bit:       x86:LE:64:default
# See $GHIDRA_INSTALL_DIR/Ghidra/Processors/*/data/languages/*.ldefs
GHIDRA_PROCESSOR_ID=ARM:LE:32:v5t

# Compiler specification ID (from *.ldefs files).
# Common values: gcc, windows, default, apcs
# GHIDRA_COMPILER_SPEC=default

# Ghidra image base for stripped ELF binaries.
# File offsets = Ghidra addresses - this value.
# Defaults to 0x10000 (standard for stripped ARM ELF).
# Only needs changing if the binary uses a different base address.
# GHIDRA_IMAGE_BASE=0x10000

# ── System Libraries (REQUIRED for proper decompile) ───────────────────────────
# Directory containing ARM32 Android system .so files to pre-import into the
# Ghidra project. Without these, ~1200 functions will remain as unresolved
# FUN_ stubs instead of being properly typed from libc, libstdc++, etc.
# These must be built from the Cocos2d-x engine separately.
# SYSTEM_LIBS_DIR=/path/to/system/libs
#
# To skip this requirement (not recommended — decompile quality will be poor):
# SYSTEM_LIBS_SKIP=1

# Comma-separated list of system library filenames to pre-import.
# Defaults to the 10 libs the binary actually imports (per Ghidra analysis).
# SYSTEM_LIBS=libandroid.so,libc.so,libdl.so,libEGL.so,libGLESv1_CM.so,libGLESv2.so,liblog.so,libm.so,libOpenSLES.so,libstdc++.so

# ── Server ─────────────────────────────────────────────────────────────────────
# Port for the JSON-RPC HTTP server.
# GHIDRA_SERVER_PORT=18960

# Inactivity timeout in seconds before the server auto-shuts down.
# Set to 0 to disable auto-shutdown.
# GHIDRA_INACTIVITY_TIMEOUT=5400

# ── Output ─────────────────────────────────────────────────────────────────────
# Directory where decompiled function exports are written.
# Defaults to: decompiled/
# DECOMPILED_DIR=/path/to/decompiled

# Entry address of mainLoop for --reachable export mode.
# When set, export.py --reachable exports only functions reachable from this
# address via BFS (1,310 funcs for this game vs ~24K total).
# Defaults to empty (disabled — falls back to scanning all functions).
# MAINLOOP_ADDR=0x4e6a9c

# ── Debug ──────────────────────────────────────────────────────────────────────
# Set to 1 for verbose DEBUG output (full tracebacks on every error).
# GHIDRA_SERVER_DEBUG=0
